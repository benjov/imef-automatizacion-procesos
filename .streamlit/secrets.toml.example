# Copia este archivo a `.streamlit/secrets.toml` para correr en local,
# o pega su contenido en Streamlit Cloud -> App settings -> Secrets.
#
# `.streamlit/secrets.toml` está en .gitignore y NUNCA debe commitearse:
# este repo es público porque GitHub Pages sirve la carpeta docs/.

ANTHROPIC_API_KEY = "sk-ant-..."

# Abre el modo EN VIVO (llamadas reales a la API) sólo a quien traiga esta
# clave en la URL:  https://<tu-app>.streamlit.app/?vivo=LA_CLAVE
#
# Sin ella, cualquier visitante ve el modo respaldo: corridas reales grabadas,
# idénticas en pantalla, que no gastan tokens ni chocan contra los límites de
# tasa. Es lo que permite repartir el enlace por QR a una sesión entera sin que
# cada clic cobre a la misma key.
#
# Si NO defines esta clave, `?vivo=1` basta — cómodo en local, inseguro en una
# app pública.
CLAVE_MODO_VIVO = "cambia-esto"
